{
  "name": "@lithiajs/common",
  "version": "0.0.4",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "directory": "packages/common"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "gen-types": "tsc --declaration --emitDeclarationOnly --declarationMap --outDir dist",
    "build": "npm run clean && ncc build src/index.ts -t -o dist --minify --no-cache --source-map && npm run gen-types"
  }
}

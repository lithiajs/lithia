{
  "name": "create-lithia-app",
  "description": "Create Lithia App",
  "version": "0.0.6",
  "bin": {
    "create-lithia-app": "dist/index.js"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "directory": "packages/create-lithia-app"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier '{src,__{tests}__}/**/*.ts' --write",
    "lint": "eslint .",
    "build": "tsup src/index.ts --clean --minify --sourcemap --format cjs --out-dir dist"
  },
  "dependencies": {
    "@lithiajs/common": "^0.0.6"
  },
  "tsup": {
    "external": [
      "@lithiajs/common"
    ]
  }
}
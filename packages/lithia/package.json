{
  "name": "lithia",
  "description": "A simple and fast web framework for Node.js",
  "version": "0.0.5",
  "license": "MIT",
  "bin": {
    "lithia": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "directory": "packages/lithia"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier '{src,__{tests}__}/**/*.ts' --write",
    "lint": "eslint .",
    "build": "tsup src/index.ts src/cli/index.ts --clean --dts --minify --sourcemap --format cjs,esm --out-dir dist"
  },
  "dependencies": {
    "@lithiajs/common": "^0.0.5",
    "@lithiajs/env": "^0.0.5"
  },
  "tsup": {
    "external": [
      "@lithiajs/common",
      "@lithiajs/env",
      "esbuild",
      "rollup"
    ]
  }
}
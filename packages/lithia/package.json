{
  "name": "lithia",
  "description": "A simple and fast web framework for Node.js",
  "version": "0.0.4",
  "license": "MIT",
  "bin": {
    "lithia": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "directory": "packages/lithia"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier '{src,__{tests}__}/**/*.ts' --write",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "gen-types": "tsc --declaration --emitDeclarationOnly --declarationMap --outDir dist",
    "build": "tsup src/index.ts --minify --sourcemap --format cjs --out-dir dist",
    "build-cli": "tsup src/cli/index.ts --minify --sourcemap --format cjs --out-dir dist/cli"
  },
  "dependencies": {
    "@lithiajs/common": "^0.0.4",
    "@lithiajs/env": "^0.0.4"
  }
}
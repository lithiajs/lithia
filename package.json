    "esbuild-plugin-d.ts": "^1.3.1",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript-eslint": "^8.31.1"
  },
  "dependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
